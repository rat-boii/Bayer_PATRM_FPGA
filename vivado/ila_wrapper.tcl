# Debug build only (build.tcl ila=1). Both generated files are plain Verilog-2001 (D17), live under build/ and are never
# part of the normal build.
#  - ila_make_wrapper: patrm_ila_top.v has the ports and interface attributes of rtl/patrm_top.v plus the outputs
#    probe0..probe4 (concatenations defined in vivado/ila_map.tcl), and instantiates the unchanged patrm_top.
#  - ila_make_top: a copy of Vivado's system_wrapper.v that keeps ila_clk and the probes inside and connects them to the
#    native ILA IP ila_0. The ILA sits outside the block design because the BASIC licence refuses the System ILA IP.

proc ila_make_top {src dst} {
    set inner {ila_clk}
    foreach entry $::ila_probes { lappend inner [lindex $entry 0] }
    set h [open $src r]; set text [read $h]; close $h
    if {![regexp -indices {module system_wrapper\s*\(([^)]*)\);} $text all list]} { error "ILA top: port list not found in $src" }
    set kept {}
    foreach p [split [string range $text [lindex $list 0] [lindex $list 1]] ,] {
        set p [string trim $p]
        if {[lsearch -exact $inner $p] < 0} { lappend kept $p }
    }
    if {[llength $kept] + [llength $inner] != [llength [split [string range $text [lindex $list 0] [lindex $list 1]] ,]]} {
        error "ILA top: ila_clk or a probe is missing from the wrapper ports"
    }
    set text [string replace $text [lindex $list 0] [lindex $list 1] [join $kept ",\n    "]]
    foreach p $inner {
        if {![regsub -line "^\\s*output\\s*(\\\[\[^\\\]\]*\\\])?\\s*$p;\\n?" $text "" text]} { error "ILA top: output $p not found" }
    }
    set co ".clk(ila_clk)"
    foreach entry $::ila_probes { set p [lindex $entry 0]; append co ",\n        .$p\($p\)" }
    if {![regsub {endmodule\s*$} $text "\n  ila_0 u_ila_0\n       ($co);\nendmodule\n" text]} { error "ILA top: endmodule not found" }
    set h [open $dst w]
    puts -nonewline $h "// GENERATED by vivado/ila_wrapper.tcl from Vivado's system_wrapper.v for the debug build (ila=1). Do not edit.\n$text"
    close $h
}

proc ila_make_wrapper {src dst} {
    set h [open $src r]; set text [read $h]; close $h
    if {![regexp -indices {module\s+patrm_top\s*#\(} $text m]} { error "ILA wrapper: patrm_top header not found in $src" }
    set start [lindex $m 0]
    if {![regexp -indices -line -start $start {^\);} $text e]} { error "ILA wrapper: end of the port list not found" }
    set header [string range $text $start [lindex $e 1]]
    set split [string first "\n) (" $header]
    if {$split < 0} { error "ILA wrapper: parameter list end not found" }

    set params {}
    foreach {all p} [regexp -all -inline -line {^\s*parameter\s+(\w+)\s*=} $header] { lappend params $p }
    set ports {}
    foreach {all p} [regexp -all -inline -line {^\s*(?:input|output)\s+wire\s*(?:\[[^\]]*\])?\s*(\w+)\s*,?} $header] { lappend ports $p }

    set decl ""; set body ""
    foreach entry $::ila_probes {
        lassign $entry probe text fields
        set w [ila_probe_width $fields]
        append decl "    output wire \[[expr {$w - 1}]:0\] $probe,   // $text\n"
        set parts {}
        foreach f $fields { set parts [linsert $parts 0 [lindex $f 1]] }
        append body "    assign $probe = {[join $parts {, }]};\n"
    }
    set head [string range $header 0 [expr {$split + 3}]]
    set tail [string range $header [expr {$split + 4}] end]
    set head [regsub {module\s+patrm_top} $head {module patrm_ila_top}]

    set pa {}; foreach p $params { lappend pa ".$p\($p\)" }
    set co {}; foreach p $ports  { lappend co ".$p\($p\)" }

    set h [open $dst w]
    puts $h "// GENERATED by vivado/ila_wrapper.tcl for the debug build (ila=1). Do not edit. Normal builds do not use it."
    puts $h "$head\n$decl[string trimleft $tail "\n"]\n"
    puts $h "    patrm_top #(\n        [join $pa ",\n        "]\n    ) u_engine (\n        [join $co ",\n        "]\n    );\n"
    puts $h $body
    puts $h "endmodule"
    close $h
}
